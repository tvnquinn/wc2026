DATABASE_URL="postgres://user:password@host:port/dbname?sslmode=require"
AUTH_SECRET="generate-a-long-random-string-for-production"

# Host league (production ships /sleepwell only). Override locally if needed.
HOST_LEAGUE_SLUG="sleepwell"
HOST_LEAGUE_NAME="SleepWell Fam"
# HOST_LEAGUE_ADMIN_PASSWORD="..."  # optional; defaults to family admin password
